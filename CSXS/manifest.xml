<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ExtensionBundleId="ps.image.capture" ExtensionBundleName="牛牛助手" ExtensionBundleVersion="1.0" Version="6.0">
  <ExtensionList>
    <Extension Id="ps.image.capture.panel" Version="1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[11.0,99.9]" />
      <Host Name="PHSP" Version="[11.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="6.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="ps.image.capture.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--disable-features=SameSiteByDefaultCookies,CookiesWithoutSameSiteMustBeSecure,NetworkService,ThirdPartyStoragePartitioning</Parameter>
            <Parameter>--disable-site-isolation-trials</Parameter>
            <Parameter>--disable-web-security</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-webgl</Parameter>
            <Parameter>--ignore-gpu-blacklist</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--enable-javascript-access-clipboard</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>牛牛助手</Menu>
          <Geometry>
            <Size>
              <Width>720</Width>
              <Height>1100</Height>
            </Size>
            <MinSize>
              <Width>320</Width>
              <Height>600</Height>
            </MinSize>
            <MaxSize>
              <Width>8000</Width>
              <Height>4000</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./img/ps.ico</Icon>
            <Icon Type="RollOver">./img/ps.ico</Icon>
            <Icon Type="DarkNormal">./img/ps.ico</Icon>
            <Icon Type="DarkRollOver">./img/ps.ico</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
